{
  "name": "ia-local",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Chat local con DeepSeek servido por LM Studio (CLI + API HTTP + SDK + web)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monzter50/boilerplate-llm-local.git"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "cli": "tsx --conditions=source src/cli.ts",
    "commit": "tsx --conditions=source packages/git-assist/src/cli.ts commit",
    "pr": "tsx --conditions=source packages/git-assist/src/cli.ts pr",
    "dev": "tsx watch --conditions=source src/server.ts",
    "server": "tsx watch --conditions=source src/server.ts",
    "web": "pnpm --filter web dev",
    "dev:all": "pnpm --parallel --filter ia-local --filter web dev",
    "build": "pnpm --filter @ia-local/contracts build && tsc -p tsconfig.build.json",
    "build:web": "pnpm --filter web build",
    "build:sdk": "pnpm --filter @ia-local/sdk build",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "build:git-assist": "pnpm --filter @ia-local/git-assist build"
  },
  "dependencies": {
    "@aglaya/logger": "0.1.0",
    "@ia-local/contracts": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "openai": "^4.77.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": "prettier --write --ignore-unknown"
  }
}
