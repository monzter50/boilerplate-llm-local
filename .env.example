# LM Studio local server (Developer tab > Start Server)
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# LM Studio ignores the API key, but the OpenAI SDK requires a non-empty value
LMSTUDIO_API_KEY=lm-studio

# Model identifier as loaded in LM Studio.
# Leave empty to auto-pick the first loaded model.
# e.g. deepseek/deepseek-r1-0528-qwen3-8b
MODEL=

# Generation parameters.
# Leave TEMPERATURE empty to let the harness use what the model family wants
# (0.6 for reasoning models such as DeepSeek R1, 0.7 otherwise). Setting it
# here overrides that for every model.
TEMPERATURE=

# Reasoning models (DeepSeek R1) spend most of MAX_TOKENS on the chain of
# thought, so keep it high or the answer comes back empty.
MAX_TOKENS=4096

# Characters of system prompt + conversation kept before the oldest turns are
# dropped. Roughly 3.5 characters per token in English or Spanish, so keep it
# well under the model's context length (n_ctx in LM Studio) times 3.5.
HISTORY_BUDGET=24000

# How long to wait for LM Studio before giving up, and how many times to retry
# a failed request. The OpenAI SDK would otherwise default to 10 minutes and 2
# retries, so a hung server holds the request open far longer than anyone waits.
REQUEST_TIMEOUT_MS=120000
MAX_RETRIES=1

# debug | info | warn | error | silent
LOG_LEVEL=info

# Default system prompt. Leave empty to use prompts/default.md instead, which
# is the recommended way to edit it: prompts/*.md are versioned and diffable,
# and any of them can be selected per request with "promptId".
SYSTEM_PROMPT=

# Port for this project's HTTP API
PORT=3000
