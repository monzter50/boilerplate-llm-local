{
  "name": "@ia-local/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed client for the IA-local HTTP API",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ia-local/contracts": "workspace:*"
  }
}
